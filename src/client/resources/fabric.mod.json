{
  "schemaVersion": 1,
  "id": "peterwolfs_replay_audio_recorder",
  "version": "${version}",
  "name": "PeterWolf's Replay Audio Recorder",
  "description": "Records Minecraft game audio during ReplayMod/Flashback recordings, plays it back in sync, and muxes it into exported MP4s. Original game-mix perspective only.",
  "authors": ["PeterWolf"],
  "contact": {
    "sources": "https://github.com/PeterWolf"
  },
  "license": "MIT",
  "icon": "assets/peterwolfs_replay_audio_recorder/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.peterwolf.replayaudio.ReplayAudioRecorderClient"
    ]
  },
  "mixins": [
    "peterwolfs_replay_audio_recorder.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "suggests": {
    "replaymod": "*",
    "flashback": "*"
  },
  "custom": {
    "modmenu:clientsideOnly": true
  }
}
